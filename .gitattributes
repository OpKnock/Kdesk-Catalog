# Line ending normalization
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Lock files - preserve exact content
*.lock binary
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary

# Explicitly mark generated files
platform-agents/**/* text eol=lf
reports/*.json text eol=lf
reports/*.md text eol=lf