{
  "version": "1.0.0",
  "name": "kdesk-yaml",
  "displayName": "Kdesk Agent/Skill YAML Support",
  "description": "Schema validation and autocomplete for Kdesk universal agent/skill YAML files",
  "contributes": {
    "yamlValidation": [
      {
        "fileMatch": ["universal-agents/**/*.yaml"],
        "url": "./schemas/universal-agent.schema.json"
      }
    ],
    "jsonValidation": [],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/kdesk-agents.json"
      }
    ]
  },
  "activationEvents": [],
  "engines": { "vscode": "^1.70.0" }
}
