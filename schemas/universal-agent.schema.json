{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdesk.catalog/schemas/universal-agent.schema.json",
  "title": "Kdesk Universal Agent/Skill",
  "description": "Canonical YAML format for universal-agents/ files (1,766 agents + 1,143 skills). Required keys are present in every file; optional keys model the two observed shapes (metadata-rich and tool-annotated skills).",
  "type": "object",
  "required": [
    "name", "display_name", "category", "description", "version",
    "platforms", "capabilities", "examples", "instructions", "knowledge"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Unique id; used as JSON id, workflow id base, and wiring key."
    },
    "display_name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "subcategory": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "type": { "enum": ["agent", "skill"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit CLI tools the skill requires."
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Runtime/tool requirements; mapped to dependencies in JSON."
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit agent->skill references (source of truth when present)."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "commands", "examples", "parameters"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "commands": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Real working CLI commands; first word is used as wiring evidence."
          },
"examples": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["input", "output"],
            "properties": {
              "input": { "type": "string" },
              "output": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string" },
                "description": { "type": "string" },
                "default": {}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "type": { "type": "string" },
              "source": { "type": "string" }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "Title": { "type": "string" },
              "description": { "type": "string" },
              "type": { "type": "string" },
              "source": { "type": "string" }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "instructions": { "type": ["string", "array"], "minLength": 1 },
    "examples": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "input": { "type": ["string", "null"] },
              "output": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "platforms": {
      "type": "object",
      "properties": {
        "claude_code": { "$ref": "#/$defs/platformBlock" },
        "cursor": { "$ref": "#/$defs/platformBlock" },
        "github_copilot": { "$ref": "#/$defs/platformBlock" },
        "windsurf": { "$ref": "#/$defs/platformBlock" },
        "opencode": { "$ref": "#/$defs/platformBlock" },
        "generic": { "$ref": "#/$defs/platformBlock" }
      },
      "additionalProperties": { "$ref": "#/$defs/platformBlock" }
    }
  },
  "$defs": {
    "platformBlock": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string" },
        "rule_type": { "type": "string" },
        "priority": { "type": "integer" },
        "prompt_file": { "type": "string" },
        "extension": { "type": "string" },
        "plugin": { "type": "string" },
        "system_prompt": { "type": "string" },
        "available_tools": { "type": "array", "items": { "type": "string" } },
        "instructions": {}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}