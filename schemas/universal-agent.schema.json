{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kdesk.catalog/schemas/universal-agent.schema.json",
  "title": "Kdesk Universal Agent/Skill",
  "description": "Canonical YAML format for universal-agents/ files (1,766 agents + 1,143 skills). Required keys are present in every file; optional keys model the two observed shapes (metadata-rich and tool-annotated skills).",
  "type": "object",
  "required": [
    "name", "display_name", "category", "description", "version",
    "platforms", "capabilities", "examples", "instructions", "knowledge"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"],
      "default": "1.0",
      "description": "Schema version for forward compatibility."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Unique id; used as JSON id, workflow id base, and wiring key."
    },
    "display_name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "subcategory": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "Optional UI accent color (hex) for generated marketplaces and portals."
    },
    "emoji": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "description": "Optional icon emoji for generated marketplaces and portals."
    },
    "vibe": {
      "type": "string",
      "minLength": 1,
      "description": "Optional tone descriptor (e.g. 'playful', 'formal', 'minimal')."
    },
    "voice": {
      "type": "string",
      "minLength": 1,
      "description": "Optional voice descriptor (e.g. 'concise', 'friendly', 'technical')."
    },
    "type": { "enum": ["agent", "skill"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit CLI tools the skill requires."
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Runtime/tool requirements; mapped to dependencies in JSON."
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit agent->skill references (source of truth when present)."
    },
    "sub_agents": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Sub-agents this agent delegates to for specialized tasks."
    },
    "delegation_pattern": {
      "type": "string",
      "enum": ["sequential", "parallel", "conditional"],
      "description": "How sub-agents are invoked: sequential (one after another), parallel (all at once), or conditional (based on context)."
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "commands", "examples", "parameters"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "commands": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Real working CLI commands; first word is used as wiring evidence."
          },
"examples": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["input", "output"],
            "properties": {
              "input": { "type": "string" },
              "output": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "description"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string" },
                "description": { "type": "string" },
                "default": {}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "description": { "type": "string" },
              "type": { "type": "string" },
              "source": { "type": "string" }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "Title": { "type": "string" },
              "description": { "type": "string" },
              "type": { "type": "string" },
              "source": { "type": "string" }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "instructions": { "type": ["string", "array"], "minLength": 1 },
    "examples": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "input": { "type": ["string", "null"] },
              "output": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "platforms": {
      "type": "object",
      "properties": {
        "claude_code": { "$ref": "#/$defs/platformBlock" },
        "cursor": { "$ref": "#/$defs/platformBlock" },
        "github_copilot": { "$ref": "#/$defs/platformBlock" },
        "windsurf": { "$ref": "#/$defs/platformBlock" },
        "opencode": { "$ref": "#/$defs/platformBlock" },
        "generic": { "$ref": "#/$defs/platformBlock" }
      },
      "additionalProperties": { "$ref": "#/$defs/platformBlock" }
    }
  },
  "examples": [
    {
      "name": "example-agent",
      "display_name": "Example Agent",
      "category": "devops",
      "subcategory": "deployment",
      "description": "One-line description",
      "version": "1.0.0",
      "color": "#10B981",
      "emoji": "🚀",
      "vibe": "pragmatic",
      "voice": "concise",
      "tags": ["kubernetes", "helm"],
      "capabilities": [
        {
          "name": "Deploy Helm Chart",
          "description": "Deploys a chart to the cluster",
          "commands": ["helm upgrade --install myapp ./chart --namespace prod"],
          "examples": ["helm upgrade --install myapp ./chart --namespace prod"],
          "parameters": [
            {
              "name": "namespace",
              "type": "string",
              "description": "Target namespace",
              "default": "default"
            }
          ]
        }
      ],
      "knowledge": [
        {
          "title": "Helm docs",
          "type": "documentation",
          "source": "https://helm.sh/docs",
          "description": "Official Helm documentation"
        }
      ],
      "instructions": "Detailed system prompt for the agent (200+ chars).",
      "examples": ["usage example"],
      "platforms": {
        "claude_code": {
          "tools": ["Bash", "Read", "Write", "Edit", "Glob", "Grep"],
          "model": "inherit"
        }
      }
    }
  ],
  "$defs": {
    "platformBlock": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string" },
        "rule_type": { "type": "string" },
        "priority": { "type": "integer" },
        "prompt_file": { "type": "string" },
        "extension": { "type": "string" },
        "plugin": { "type": "string" },
        "system_prompt": { "type": "string" },
        "available_tools": { "type": "array", "items": { "type": "string" } },
        "instructions": {}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}